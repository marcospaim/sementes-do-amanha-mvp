# Copie para .env e ajuste. NUNCA versione segredos reais.
SECRET_KEY=troque-por-uma-chave-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Deixe vazio para usar SQLite local.
# Em produção, use a URL do PostgreSQL gerenciado:
# DATABASE_URL=postgres://usuario:senha@host:5432/banco?sslmode=require
DATABASE_URL=

# Somente ative atrás de um proxy reverso confiável (Render, Railway etc.).
USE_X_FORWARDED_PROTO=False

# Origens confiáveis para CSRF, separadas por vírgula. Ex.: https://meuapp.onrender.com
CSRF_TRUSTED_ORIGINS=
